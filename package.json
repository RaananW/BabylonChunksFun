{
  "name": "babylon-code-splitting",
  "version": "1.0.0",
  "description": "Babylon.js code splitting using webpack and rollup",
  "private": true,
  "scripts": {
    "build": "npm run webpack:build && npm run rollup:build",
    "check": "npm test && npm run typecheck && npm run webpack:build && npm run webpack:webgl-gltf:build && npm run webpack:webgpu-gltf:build && npm run rollup:build && npm run rollup:webgl-gltf:build && npm run rollup:webgpu-gltf:build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "webpack:build": "webpack",
    "webpack:production:build": "webpack --env=mode=production",
    "webpack:webgl-gltf:build": "webpack --env=optimization=\"webgl,gltf,textureLoaders,vendors\" --env=ignore=\"webgpu,notGLTF\"",
    "webpack:webgl-gltf:serve": "webpack serve --env=optimization=\"webgl,gltf,textureLoaders,vendors\" --env=ignore=\"webgpu,notGLTF\"",
    "webpack:webgpu-gltf:build": "webpack --env=optimization=\"webgpu,gltf,textureLoaders,vendors\" --env=ignore=\"notGLTF,notWebGPU\"",
    "webpack:webgpu-gltf:serve": "webpack serve --env=optimization=\"webgpu,gltf,textureLoaders,vendors\" --env=ignore=\"notGLTF,notWebGPU\"",
    "webpack:serve": "webpack serve",
    "rollup:build": "rimraf dist-rollup && rollup -c",
    "rollup:production:build": "rimraf dist-rollup && rollup -c --environment NODE_ENV:production",
    "rollup:webgl-gltf:build": "rimraf dist-rollup && rollup -c --environment \"ignore:webgpu;notGLTF\"",
    "rollup:webgpu-gltf:build": "rimraf dist-rollup && rollup -c --environment \"ignore:notWebGPU;notGLTF\""
  },
  "author": "Raanan Weber (@RaananW)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/loaders": "^9.25.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.16.2",
    "html-webpack-plugin": "^5.6.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "source-map-loader": "^5.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
